// Prisma Schema for AI Finance Manager
// Provider: MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum AccountType {
  BANK
  CASH
  WALLET
  CREDIT_CARD
  SAVINGS
  INVESTMENT
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique @db.VarChar(255)
  passwordHash String        @db.VarChar(255)
  firstName    String        @db.VarChar(100)
  lastName     String        @db.VarChar(100)
  role         Role          @default(USER)
  isVerified   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relationships
  otpTokens     OtpToken[]
  refreshTokens RefreshToken[]
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  budgets       Budget[]
  goals         Goal[]

  @@index([email])
  @@map("users")
}

model OtpToken {
  id        String    @id @default(uuid())
  userId    String
  otpHash   String    @db.VarChar(255)
  type      OtpType
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("otp_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @db.VarChar(255)
  family    String    @default(uuid()) @db.VarChar(255)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([family])
  @@map("refresh_tokens")
}

model Account {
  id         String      @id @default(uuid())
  userId     String
  name       String      @db.VarChar(100)
  type       AccountType @default(BANK)
  balance    Decimal     @default(0.00) @db.Decimal(14, 2)
  currency   String      @default("INR") @db.VarChar(10)
  isArchived Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Relationships
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions            Transaction[] @relation("SourceAccount")
  destinationTransactions Transaction[] @relation("DestinationAccount")

  @@unique([userId, name])
  @@index([userId])
  @@map("accounts")
}

model Category {
  id        String       @id @default(uuid())
  userId    String?
  name      String       @db.VarChar(100)
  icon      String?      @db.VarChar(50)
  color     String?      @db.VarChar(30)
  type      CategoryType
  isSystem  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relationships
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name, type])
  @@index([userId])
  @@index([isSystem])
  @@map("categories")
}

model Transaction {
  id                   String          @id @default(uuid())
  userId               String
  accountId            String
  destinationAccountId String?
  categoryId           String?
  type                 TransactionType
  amount               Decimal         @db.Decimal(14, 2)
  description          String?         @db.Text
  transactionDate      DateTime        @default(now())
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  // Relationships
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account            Account   @relation("SourceAccount", fields: [accountId], references: [id], onDelete: Restrict)
  destinationAccount Account?  @relation("DestinationAccount", fields: [destinationAccountId], references: [id], onDelete: Restrict)
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, transactionDate])
  @@index([accountId])
  @@index([destinationAccountId])
  @@index([categoryId])
  @@map("transactions")
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  categoryId String
  amount     Decimal  @db.Decimal(14, 2)
  month      Int      // 1-12
  year       Int      // e.g. 2026
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relationships
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@index([userId, year, month])
  @@index([categoryId])
  @@map("budgets")
}

model Goal {
  id            String    @id @default(uuid())
  userId        String
  name          String    @db.VarChar(150)
  targetAmount  Decimal   @db.Decimal(14, 2)
  currentAmount Decimal   @default(0.00) @db.Decimal(14, 2)
  targetDate    DateTime? @db.Date
  isCompleted   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}

